<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls /boot/config/plugins/&name;/gpu-switch-manager*.txz 2>/dev/null|grep -v '&version;')
</INLINE>
</FILE>

<FILE Name="/boot/config/plugins/&name;/gpu-switch-manager-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/&version;/gpu-switch-manager-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE>
**GPU Switch Manager**

This plugin provides automated GPU driver switching for VM passthrough and Docker containers.
Toggle GPUs between host/Docker use and VM isolation without manual XML editing.

Features:
- Real-time GPU stats dashboard
- Persistent profile management
- Event-driven GPU switching
- Docker and VM service coordination
- Security-hardened implementation

For more information, visit: https://github.com/thewolfman56/unraid-gpu-switch-manager
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

echo "-----------------------------------------------"
echo "----Installation of GPU Switch Manager-------"
echo "-----------------------------------------------"

# Set proper permissions
chmod -R 755 /usr/local/emhttp/plugins/&name;
chmod -R 755 /usr/local/emhttp/websettings/&name;

# Make scripts executable
find /usr/local/emhttp/plugins/&name;/scripts -type f -name "*.sh" -exec chmod 755 {} \; 2>/dev/null || true
find /usr/local/emhttp/plugins/&name;/event -type f -exec chmod 755 {} \; 2>/dev/null || true

echo
echo "----Installation of GPU Switch Manager complete-----"
echo "-----------------------------------------------"
echo
echo "Access the plugin from:"
echo "Settings -> GPU Switch Manager"
echo "-----------------------------------------------"
echo

</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>

echo "-----------------------------------------------"
echo "----------Uninstalling GPU Switch Manager-------"
echo "-----------------------------------------------"

# Stop any running services
if [ -f /usr/local/emhttp/plugins/&name;/event/unregister_event_handlers.sh ]; then
  /usr/local/emhttp/plugins/&name;/event/unregister_event_handlers.sh
fi

# Remove plugin related files
rm -rf /usr/local/emhttp/plugins/&name;
rm -rf /usr/local/emhttp/websettings/&name;
rm -rf &plugin;

echo
echo "-----------------------------------------------"
echo "---Uninstallation of GPU Switch Manager complete!---"
echo "-----------------------------------------------"
echo

</INLINE>
</FILE>

</PLUGIN>
