    <select id="PROTECT_PRIMARY_GPU" name="PROTECT_PRIMARY_GPU" size="1">
        <option value="true" <?=($cfg['PROTECT_PRIMARY_GPU'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['PROTECT_PRIMARY_GPU'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    Primary GPU:
    <select id="PRIMARY_GPU" name="PRIMARY_GPU" size="1">
        <option value="">Select GPU...</option>
      </select>

    Require Confirmation:
    <select id="REQUIRE_CONFIRMATION" name="REQUIRE_CONFIRMATION" size="1">
        <option value="true" <?=($cfg['REQUIRE_CONFIRMATION'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['REQUIRE_CONFIRMATION'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    Backup Configuration:
    <select id="BACKUP_CONFIG" name="BACKUP_CONFIG" size="1">
        <option value="true" <?=($cfg['BACKUP_CONFIG'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['BACKUP_CONFIG'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    <h3><b>Dashboard Settings</b></h3>

    Refresh Interval (seconds):
    <input type="number" name="REFRESH_INTERVAL" class="narrow" min="1" max="60" value="<?=$cfg['REFRESH_INTERVAL'];?>" placeholder="5">
    <br>

    Show Temperatures:
    <select id="SHOW_TEMPERATURES" name="SHOW_TEMPERATURES" size="1">
        <option value="true" <?=($cfg['SHOW_TEMPERATURES'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['SHOW_TEMPERATURES'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    Show Utilization:
    <select id="SHOW_UTILIZATION" name="SHOW_UTILIZATION" size="1">
        <option value="true" <?=($cfg['SHOW_UTILIZATION'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['SHOW_UTILIZATION'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    <h3><b>GPU Profiles</b></h3>

    <p><em>GPU profiles allow you to save and restore GPU configurations for different use cases.</em></p>

    <h4><b>Profile Management</b></h4>

    <p><strong>Current Profiles:</strong></p>
    <div id="profile-list" style="margin: 10px 0; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px;">
        <p><em>Loading profiles...</em></p>
    </div>

    <div style="margin: 10px 0;">
        <button type="button" id="btnCreateProfile" class="button">Create New Profile</button>
        <button type="button" id="btnRefreshProfiles" class="button">Refresh Profiles</button>
    </div>

    <h4><b>Profiles Enabled</b></h4>

    <p><strong>Select profiles to enable for event monitoring:</strong></p>
    <div id="profiles-enabled-list" style="margin: 10px 0; padding: 10px; background: #e8f4f8; border: 1px solid #b8d4e8; border-radius: 4px;">
        <p><em>Loading profiles...</em></p>
    </div>
    <p><small style="color: #666;">Enabled profiles will actively monitor VM startup and shutdown events to manage GPU switching automatically.</small></p>

    <!-- Profile Creation/Edit Modal -->
    <div id="profileModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;">
        <div style="position: relative; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 20px; border-radius: 8px; max-width: 800px; width: 90%; max-height: 90vh; overflow-y: auto;">
            <h3 id="profileModalTitle">Create New Profile</h3>
            <form id="profileForm">
                <input type="hidden" id="editProfileName" value="">

                <div style="margin: 15px 0;">
                    <label><strong>Target VM (Profile Name):</strong></label>
                    <select id="profileVM" required style="width: 100%; margin-top: 5px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                        <option value="">Select VM...</option>
                    </select>
                    <small style="color: #666;">This VM will be monitored for startup and shutdown events</small>
                </div>

                <div style="margin: 15px 0;">
                    <label><strong>GPU to Pass Through:</strong></label>
                    <select id="profileGPU" required style="width: 100%; margin-top: 5px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                        <option value="">Select GPU...</option>
                    </select>
                </div>

                <div style="margin: 15px 0;">
                    <label><strong>GPU Containers (Docker containers that use GPU):</strong></label>
                    <div id="gpuContainersList" style="margin-top: 5px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px; max-height: 200px; overflow-y: auto;">
                        <p><em>Loading Docker containers...</em></p>
                    </div>
                    <small style="color: #666;">Select containers that use the GPU. These will be stopped when VM starts and restarted when VM stops.</small>
                </div>

                <div style="margin: 15px 0;">
                    <label><strong>CPU Containers (Docker containers that replace GPU functionality):</strong></label>
                    <div id="cpuContainersList" style="margin-top: 5px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px; max-height: 200px; overflow-y: auto;">
                        <p><em>Loading Docker containers...</em></p>
                    </div>
                    <small style="color: #666;">Select containers that provide CPU-based alternatives. These will be started when VM stops.</small>
                </div>

                <div style="margin: 15px 0;">
                    <label><strong>Other VMs to Shutdown:</strong></label>
                    <div id="otherVMsShutdownList" style="margin-top: 5px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px; max-height: 200px; overflow-y: auto;">
                        <p><em>Loading VMs...</em></p>
                    </div>
                    <small style="color: #666;">Select VMs that should be shutdown when this profile's VM starts.</small>
                </div>

                <div style="margin: 15px 0;">
                    <label><strong>Other VMs to Restart (with priority):</strong></label>
                    <div id="otherVMsRestartList" style="margin-top: 5px; padding: 10px; background: #f9f9f9; border: 1px solid #ddd; border-radius: 4px; max-height: 200px; overflow-y: auto;">
                        <p><em>Loading VMs...</em></p>
                    </div>
                    <small style="color: #666;">Select VMs that should be restarted when this profile's VM starts. Use priority numbers (1 = highest priority).</small>
                </div>

                <div style="margin-top: 20px; text-align: right;">
                    <button type="button" id="btnCancelProfile" class="button">Cancel</button>
                    <button type="submit" id="btnSaveProfile" class="button">Save Profile</button>
                </div>
            </form>
        </div>
    </div>

    <h4><b>Real-time GPU Statistics</b></h4>

    <div id="gpu-stats" style="margin: 10px 0; padding: 15px; background: #f0f8ff; border: 1px solid #b0d4f1; border-radius: 4px;">
        <p><em>Loading GPU statistics...</em></p>
    </div>

    <div style="margin: 10px 0;">
        <button type="button" id="btnRefreshStats" class="button">Refresh Statistics</button>
        <label style="margin-left: 10px;">
            <input type="checkbox" id="autoRefreshStats" <?=($cfg['AUTO_REFRESH_STATS'] == 'true') ? 'checked' : ''?>> Auto-refresh (5s)
        </label>
    </div>

    <h4><b>GPU Binding Controls</b></h4>

    <div id="gpu-binding" style="margin: 10px 0; padding: 15px; background: #fff8f0; border: 1px solid #f5d4a3; border-radius: 4px;">
        <p><em>Loading GPU binding information...</em></p>
    </div>

    <div style="margin: 10px 0;">
        <label>Target GPU:</label>
        <select id="targetGPU" name="TARGET_GPU" size="1" style="margin-left: 10px;">
            <option value="">Select GPU...</option>
        </select>

        <label style="margin-left: 20px;">Binding Mode:</label>
        <select id="bindingMode" name="BINDING_MODE" size="1" style="margin-left: 10px;">
            <option value="host">Host/Docker</option>
            <option value="vm">VM Passthrough</option>
            <option value="none">Unbound</option>
        </select>

        <button type="button" id="btnApplyBinding" class="button" style="margin-left: 10px;">Apply Binding</button>
    </div>

    <h4><b>Docker/VM Integration</b></h4>

    <div style="margin: 10px 0;">
        <label>Auto-start VM with GPU:</label>
        <select id="autoStartVM" name="AUTO_START_VM" size="1" style="margin-left: 10px;">
            <option value="true" <?=($cfg['AUTO_START_VM'] == 'true') ? 'selected' : ''?>>Yes</option>
            <option value="false" <?=($cfg['AUTO_START_VM'] == 'false') ? 'selected' : ''?>>No</option>
        </select>
    </div>

    <div style="margin: 10px 0;">
        <label>Target VM Name:</label>
        <input type="text" name="TARGET_VM_NAME" value="<?=$cfg['TARGET_VM_NAME'];?>" placeholder="e.g., gaming-vm" style="margin-left: 10px; width: 200px;">
    </div>

    <div style="margin: 10px 0;">
        <label>Docker Container Integration:</label>
        <select id="dockerIntegration" name="DOCKER_INTEGRATION" size="1" style="margin-left: 10px;">
            <option value="true" <?=($cfg['DOCKER_INTEGRATION'] == 'true') ? 'selected' : ''?>>Enabled</option>
            <option value="false" <?=($cfg['DOCKER_INTEGRATION'] == 'false') ? 'selected' : ''?>>Disabled</option>
        </select>
    </div>

    <div style="margin: 10px 0;">
        <label>Protected Containers (comma-separated):</label>
        <input type="text" name="PROTECTED_CONTAINERS" value="<?=$cfg['PROTECTED_CONTAINERS'];?>" placeholder="e.g., plex,emby,jellyfin" style="margin-left: 10px; width: 300px;">
    </div>

    <div style="margin: 10px 0;">
        <label>VM Shutdown on GPU Release:</label>
        <select id="vmShutdown" name="VM_SHUTDOWN_ON_RELEASE" size="1" style="margin-left: 10px;">
            <option value="true" <?=($cfg['VM_SHUTDOWN_ON_RELEASE'] == 'true') ? 'selected' : ''?>>Yes</option>
            <option value="false" <?=($cfg['VM_SHUTDOWN_ON_RELEASE'] == 'false') ? 'selected' : ''?>>No</option>
        </select>
    </div>

    <p><strong>Note:</strong> Profile management and advanced GPU operations are available through the main GPU Switch Manager interface.</p>
    <p>Access the full GPU management interface at: <a href="/plugins/gpu-switch-manager/gpu-switch-manager.php" target="_blank">GPU Switch Manager Dashboard</a></p>

