      </select>

    Debug Mode:
    <select id="DEBUG" name="DEBUG" size="1">
        <option value="true" <?=($cfg['DEBUG'] == 'true') ? 'selected' : ''?>>Yes</option>
        <option value="false" <?=($cfg['DEBUG'] == 'false') ? 'selected' : ''?>>No</option>
      </select>

    Log Level:
    <select id="LOG_LEVEL" name="LOG_LEVEL" size="1">
        <option value="debug" <?=($cfg['LOG_LEVEL'] == 'debug') ? 'selected' : ''?>>Debug</option>
        <option value="info" <?=($cfg['LOG_LEVEL'] == 'info') ? 'selected' : ''?>>Info</option>
        <option value="warning" <?=($cfg['LOG_LEVEL'] == 'warning') ? 'selected' : ''?>>Warning</option>
        <option value="error" <?=($cfg['LOG_LEVEL'] == 'error') ? 'selected' : ''?>>Error</option>
      </select>

    <h3><b>Operation Settings</b></h3>

