<script>
$(function() {
    // Enable Apply button when form changes
    $('form').on('change', 'select, input', function() {
        $('#btnApply').prop('disabled', false);
    });

    // Profile Management
    loadProfiles();
    loadEnabledProfiles();
    loadGPUsForProfile();
    loadVMsForProfile();
    loadDockerContainers();
    loadPrimaryGPUs();

    $('#btnCreateProfile').on('click', function() {
        openProfileModal();
    });

    $('#btnRefreshProfiles').on('click', function() {
        loadProfiles();
        loadEnabledProfiles();
    });

    $('#btnCancelProfile').on('click', function() {
        closeProfileModal();
    });

    $('#profileForm').on('submit', function(e) {
        e.preventDefault();
        saveProfile();
    });

    // GPU Statistics
    loadGPUStats();

    $('#btnRefreshStats').on('click', function() {
        loadGPUStats();
    });

    // Auto-refresh statistics
    var statsInterval;
    $('#autoRefreshStats').on('change', function() {
        if ($(this).is(':checked')) {
            statsInterval = setInterval(loadGPUStats, 5000);
        } else {
            clearInterval(statsInterval);
        }
    });

    // GPU Binding
    loadGPUBinding();

    $('#btnApplyBinding').on('click', function() {
        applyGPUBinding();
    });

    // Functions
    function loadProfiles() {
        $('#profile-list').html('<p><em>Loading profiles...</em></p>');

        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_profiles.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.profiles && Object.keys(data.profiles).length > 0) {
                    var html = '<table style="width: 100%; border-collapse: collapse;">';
                    html += '<tr style="background: #e0e0e0;"><th style="padding: 8px; text-align: left;">Profile Name</th><th style="padding: 8px; text-align: left;">GPU</th><th style="padding: 8px; text-align: left;">Status</th><th style="padding: 8px; text-align: left;">Actions</th></tr>';

                    $.each(data.profiles, function(name, profile) {
                        html += '<tr style="border-bottom: 1px solid #ddd;">';
                        html += '<td style="padding: 8px;"><strong>' + name + '</strong>';
                        if (profile.enabled) {
                            html += ' <span style="color: green; font-size: 12px;">● Enabled</span>';
                        }
                        html += '<br><small style="color: #666;">';
                        html += 'VM: ' + (profile.vm_name || 'N/A');
                        if (profile.gpu_containers && profile.gpu_containers.length > 0) {
                            html += ' | GPU Containers: ' + profile.gpu_containers.length;
                        }
                        if (profile.cpu_containers && profile.cpu_containers.length > 0) {
                            html += ' | CPU Containers: ' + profile.cpu_containers.length;
                        }
                        html += '</small></td>';
                        html += '<td style="padding: 8px;">' + (profile.gpu || 'N/A') + '</td>';
                        html += '<td style="padding: 8px;">' + (profile.enabled ? 'Active' : 'Inactive') + '</td>';
                        html += '<td style="padding: 8px;">';
                        html += '<button type="button" class="button" onclick="editProfile(\'' + name + '\')">Edit</button> ';
                        html += '<button type="button" class="button" onclick="applyProfile(\'' + name + '\')">Apply</button> ';
                        html += '<button type="button" class="button" onclick="deleteProfile(\'' + name + '\')">Delete</button>';
                        html += '</td>';
                        html += '</tr>';
                    });

                    html += '</table>';
                    $('#profile-list').html(html);
                } else {
                    $('#profile-list').html('<p><em>No profiles found. Create your first profile to get started.</em></p>');
                }
            },
            error: function() {
                $('#profile-list').html('<p><em>Error loading profiles. Please try again.</em></p>');
            }
        });
    }

    function createProfile() {
        openProfileModal();
    }

    function editProfile(name) {
        // Load profile data and populate modal
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_profiles.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.profiles && data.profiles[name]) {
                    var profile = data.profiles[name];
                    $('#editProfileName').val(name);
                    $('#profileVM').val(profile.vm_name || '');
                    $('#profileGPU').val(profile.gpu || '');

                    // Clear all checkboxes first
                    $('#gpuContainersList input[type="checkbox"]').prop('checked', false);
                    $('#cpuContainersList input[type="checkbox"]').prop('checked', false);
                    $('#otherVMsShutdownList input[type="checkbox"]').prop('checked', false);
                    $('#otherVMsRestartList input[type="checkbox"]').prop('checked', false);

                    // Set GPU containers
                    if (profile.gpu_containers && Array.isArray(profile.gpu_containers)) {
                        $.each(profile.gpu_containers, function(index, containerName) {
                            $('#gpuContainersList input[type="checkbox"][value="' + containerName + '"]').prop('checked', true);
                        });
                    }

                    // Set CPU containers
                    if (profile.cpu_containers && Array.isArray(profile.cpu_containers)) {
                        $.each(profile.cpu_containers, function(index, containerName) {
                            $('#cpuContainersList input[type="checkbox"][value="' + containerName + '"]').prop('checked', true);
                        });
                    }

                    // Set other VMs to shutdown
                    if (profile.other_vms_shutdown && Array.isArray(profile.other_vms_shutdown)) {
                        $.each(profile.other_vms_shutdown, function(index, vmName) {
                            $('#otherVMsShutdownList input[type="checkbox"][value="' + vmName + '"]').prop('checked', true);
                        });
                    }

                    // Set other VMs to restart with priority
                    if (profile.other_vms_restart && Array.isArray(profile.other_vms_restart)) {
                        $.each(profile.other_vms_restart, function(index, vmConfig) {
                            var vmName = vmConfig.name;
                            var priority = vmConfig.priority || 1;
                            $('#otherVMsRestartList input[type="checkbox"][value="' + vmName + '"]').prop('checked', true);
                            $('#otherVMsRestartList input[type="checkbox"][value="' + vmName + '"]').each(function() {
                                var checkboxId = $(this).attr('id');
                                if (checkboxId) {
                                    $('#restart_priority_' + checkboxId.replace('restart_vm_', '')).val(priority);
                                }
                            });
                        });
                    }

                    $('#profileModalTitle').text('Edit Profile: ' + name);
                    $('#profileModal').show();
                } else {
                    alert('Profile not found: ' + name);
                }
            },
            error: function() {
                alert('Error loading profile data');
            }
        });
    }

    function openProfileModal() {
        $('#editProfileName').val('');
        $('#profileVM').val('');
        $('#profileGPU').val('');

        // Clear all checkboxes
        $('#gpuContainersList input[type="checkbox"]').prop('checked', false);
        $('#cpuContainersList input[type="checkbox"]').prop('checked', false);
        $('#otherVMsShutdownList input[type="checkbox"]').prop('checked', false);
        $('#otherVMsRestartList input[type="checkbox"]').prop('checked', false);

        // Reset priority dropdowns
        $('#otherVMsRestartList select').val('1');

        $('#profileModalTitle').text('Create New Profile');
        $('#profileModal').show();
    }

    function closeProfileModal() {
        $('#profileModal').hide();
    }

    function saveProfile() {
        var editName = $('#editProfileName').val();
        var vmName = $('#profileVM').val();
        var isEdit = editName.length > 0;

        if (!vmName) {
            alert('Please select a VM for this profile');
            return;
        }

        var gpuId = $('#profileGPU').val();
        if (!gpuId) {
            alert('Please select a GPU to pass through');
            return;
        }

        // Collect GPU containers
        var gpuContainers = [];
        $('#gpuContainersList input[type="checkbox"]:checked').each(function() {
            gpuContainers.push($(this).val());
        });

        // Collect CPU containers
        var cpuContainers = [];
        $('#cpuContainersList input[type="checkbox"]:checked').each(function() {
            cpuContainers.push($(this).val());
        });

        // Check for overlap between GPU and CPU containers
        var overlap = gpuContainers.filter(function(container) {
            return cpuContainers.indexOf(container) !== -1;
        });
        if (overlap.length > 0) {
            alert('The following containers cannot be in both GPU and CPU lists: ' + overlap.join(', '));
            return;
        }

        // Collect other VMs to shutdown
        var otherVMsShutdown = [];
        $('#otherVMsShutdownList input[type="checkbox"]:checked').each(function() {
            otherVMsShutdown.push($(this).val());
        });

        // Collect other VMs to restart with priority
        var otherVMsRestart = [];
        $('#otherVMsRestartList input[type="checkbox"]:checked').each(function() {
            var vmName = $(this).val();
            var priority = $('#restart_priority_' + $(this).attr('id').replace('restart_vm_', '')).val();
            otherVMsRestart.push({
                name: vmName,
                priority: parseInt(priority)
            });
        });

        // Sort by priority
        otherVMsRestart.sort(function(a, b) {
            return a.priority - b.priority;
        });

        var profileData = {
            name: vmName, // Use VM name as profile name
            vm_name: vmName,
            gpu: gpuId,
            gpu_containers: gpuContainers,
            cpu_containers: cpuContainers,
            other_vms_shutdown: otherVMsShutdown,
            other_vms_restart: otherVMsRestart,
            enabled: false,
            created: isEdit ? undefined : new Date().toISOString(),
            updated: new Date().toISOString()
        };

        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/' + (isEdit ? 'update_profile.php' : 'create_profile.php'),
            method: 'POST',
            data: isEdit ? { old_name: editName, profile_data: JSON.stringify(profileData) } : { profile_data: JSON.stringify(profileData) },
            success: function() {
                closeProfileModal();
                loadProfiles();
                loadEnabledProfiles();
                loadVMsForProfile(); // Refresh VM list to exclude newly used VM
                alert(isEdit ? 'Profile updated successfully!' : 'Profile created successfully!');
            },
            error: function() {
                alert('Error saving profile. Please try again.');
            }
        });
    }

    function loadGPUsForProfile() {
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_gpu_binding.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.gpus && data.gpus.length > 0) {
                    $('#profileGPU').find('option').remove().end().append('<option value="">Select GPU...</option>');
                    $.each(data.gpus, function(index, gpu) {
                        $('#profileGPU').append('<option value="' + gpu.id + '">' + gpu.name + '</option>');
                    });
                } else {
                    $('#profileGPU').find('option').remove().end().append('<option value="">No GPUs detected</option>');
                }
            },
            error: function() {
                $('#profileGPU').find('option').remove().end().append('<option value="">Error loading GPUs</option>');
            }
        });
    }

    function loadPrimaryGPUs() {
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_gpu_binding.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.gpus && data.gpus.length > 0) {
                    $('#PRIMARY_GPU').find('option').remove().end().append('<option value="">Select GPU...</option>');
                    $.each(data.gpus, function(index, gpu) {
                        $('#PRIMARY_GPU').append('<option value="' + gpu.id + '">' + gpu.name + '</option>');
                    });
                } else {
                    $('#PRIMARY_GPU').find('option').remove().end().append('<option value="">No GPUs detected</option>');
                }
            },
            error: function() {
                $('#PRIMARY_GPU').find('option').remove().end().append('<option value="">Error loading GPUs</option>');
            }
        });
    }

    function loadVMsForProfile() {
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_vms.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.vms && data.vms.length > 0) {
                    // Load existing profiles to exclude used VMs
                    $.ajax({
                        url: '/plugins/gpu-switch-manager/scripts/get_profiles.php',
                        method: 'GET',
                        dataType: 'json',
                        success: function(profilesData) {
                            var usedVMs = [];
                            if (profilesData.profiles) {
                                $.each(profilesData.profiles, function(profileName, profile) {
                                    if (profile.vm_name) {
                                        usedVMs.push(profile.vm_name);
                                    }
                                });
                            }

                            $('#profileVM').find('option').remove().end().append('<option value="">Select VM...</option>');
                            $.each(data.vms, function(index, vm) {
                                if (usedVMs.indexOf(vm.name) === -1) {
                                    $('#profileVM').append('<option value="' + vm.name + '">' + vm.name + '</option>');
                                }
                            });

                            // Load other VMs for shutdown/restart lists
                            loadOtherVMsLists(data.vms);
                        },
                        error: function() {
                            // If profiles load fails, still show all VMs
                            $('#profileVM').find('option').remove().end().append('<option value="">Select VM...</option>');
                            $.each(data.vms, function(index, vm) {
                                $('#profileVM').append('<option value="' + vm.name + '">' + vm.name + '</option>');
                            });
                            loadOtherVMsLists(data.vms);
                        }
                    });
                } else {
                    $('#profileVM').find('option').remove().end().append('<option value="">No VMs detected</option>');
                }
            },
            error: function() {
                $('#profileVM').find('option').remove().end().append('<option value="">Error loading VMs</option>');
            }
        });
    }

    function loadOtherVMsLists(allVMs) {
        // Get currently selected VM to exclude from other VMs lists
        var selectedVM = $('#profileVM').val();

        // Other VMs to Shutdown
        $('#otherVMsShutdownList').empty();
        if (allVMs.length > 0) {
            $.each(allVMs, function(index, vm) {
                if (vm.name !== selectedVM) {
                    $('#otherVMsShutdownList').append(
                        '<div style="margin: 5px 0;">' +
                        '<input type="checkbox" id="shutdown_vm_' + index + '" value="' + vm.name + '" style="margin-right: 8px;">' +
                        '<label for="shutdown_vm_' + index + '">' + vm.name + '</label>' +
                        '</div>'
                    );
                }
            });
        } else {
            $('#otherVMsShutdownList').append('<p><em>No VMs available</em></p>');
        }

        // Other VMs to Restart with priority
        $('#otherVMsRestartList').empty();
        if (allVMs.length > 0) {
            $.each(allVMs, function(index, vm) {
                if (vm.name !== selectedVM) {
                    $('#otherVMsRestartList').append(
                        '<div style="margin: 5px 0;">' +
                        '<input type="checkbox" id="restart_vm_' + index + '" value="' + vm.name + '" style="margin-right: 8px;">' +
                        '<label for="restart_vm_' + index + '">' + vm.name + '</label>' +
                        '<select id="restart_priority_' + index + '" style="margin-left: 10px; padding: 4px; border: 1px solid #ccc; border-radius: 4px;">' +
                        '<option value="1">Priority 1</option>' +
                        '<option value="2">Priority 2</option>' +
                        '<option value="3">Priority 3</option>' +
                        '<option value="4">Priority 4</option>' +
                        '<option value="5">Priority 5</option>' +
                        '</select>' +
                        '</div>'
                    );
                }
            });
        } else {
            $('#otherVMsRestartList').append('<p><em>No VMs available</em></p>');
        }
    }

    function loadDockerContainers() {
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_docker_containers.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.containers && data.containers.length > 0) {
                    // GPU Containers
                    $('#gpuContainersList').empty();
                    $.each(data.containers, function(index, container) {
                        $('#gpuContainersList').append(
                            '<div style="margin: 5px 0;">' +
                            '<input type="checkbox" id="gpu_container_' + index + '" value="' + container.name + '" style="margin-right: 8px;">' +
                            '<label for="gpu_container_' + index + '">' + container.name + '</label>' +
                            '</div>'
                        );
                    });

                    // CPU Containers (same list, different selection)
                    $('#cpuContainersList').empty();
                    $.each(data.containers, function(index, container) {
                        $('#cpuContainersList').append(
                            '<div style="margin: 5px 0;">' +
                            '<input type="checkbox" id="cpu_container_' + index + '" value="' + container.name + '" style="margin-right: 8px;">' +
                            '<label for="cpu_container_' + index + '">' + container.name + '</label>' +
                            '</div>'
                        );
                    });
                } else {
                    $('#gpuContainersList').append('<p><em>No Docker containers detected</em></p>');
                    $('#cpuContainersList').append('<p><em>No Docker containers detected</em></p>');
                }
            },
            error: function() {
                $('#gpuContainersList').append('<p><em>Error loading Docker containers</em></p>');
                $('#cpuContainersList').append('<p><em>Error loading Docker containers</em></p>');
            }
        });
    }

    function loadEnabledProfiles() {
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_profiles.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.profiles && Object.keys(data.profiles).length > 0) {
                    var html = '';
                    $.each(data.profiles, function(name, profile) {
                        var isEnabled = profile.enabled === true;
                        html += '<div style="margin: 8px 0;">';
                        html += '<input type="checkbox" id="enabled_profile_' + name + '" value="' + name + '" ' + (isEnabled ? 'checked' : '') + ' style="margin-right: 8px;" onchange="toggleProfileEnabled(\'' + name + '\')">';
                        html += '<label for="enabled_profile_' + name + '"><strong>' + name + '</strong>';
                        if (profile.vm_name) {
                            html += ' (VM: ' + profile.vm_name + ')';
                        }
                        html += '</label>';
                        html += '</div>';
                    });
                    $('#profiles-enabled-list').html(html);
                } else {
                    $('#profiles-enabled-list').html('<p><em>No profiles created yet</em></p>');
                }
            },
            error: function() {
                $('#profiles-enabled-list').html('<p><em>Error loading profiles</em></p>');
            }
        });
    }

    function toggleProfileEnabled(profileName) {
        var isEnabled = $('#enabled_profile_' + profileName).is(':checked');
        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/toggle_profile_enabled.php',
            method: 'POST',
            data: { name: profileName, enabled: isEnabled },
            success: function() {
                // Profile enabled status updated
            },
            error: function() {
                alert('Error updating profile enabled status');
                // Revert checkbox on error
                $('#enabled_profile_' + profileName).prop('checked', !isEnabled);
            }
        });
    }

    function deleteProfile(name) {
        if (confirm('Are you sure you want to delete profile: ' + name + '?')) {
            $.ajax({
                url: '/plugins/gpu-switch-manager/scripts/delete_profile.php',
                method: 'POST',
                data: { name: name },
                success: function() {
                    loadProfiles();
                    alert('Profile deleted successfully!');
                },
                error: function() {
                    alert('Error deleting profile. Please try again.');
                }
            });
        }
    }

    function applyProfile(name) {
        if (confirm('Are you sure you want to apply profile: ' + name + '? This will modify GPU bindings and may stop/start containers and VMs.')) {
            $.ajax({
                url: '/plugins/gpu-switch-manager/scripts/apply_profile.php',
                method: 'POST',
                data: { name: name },
                success: function() {
                    alert('Profile applied successfully! GPU binding changes have been queued.');
                    loadGPUBinding();
                    loadGPUStats();
                },
                error: function() {
                    alert('Error applying profile. Please try again.');
                }
            });
        }
    }

    function loadGPUStats() {
        $('#gpu-stats').html('<p><em>Loading GPU statistics...</em></p>');

        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_gpu_stats.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.gpus && data.gpus.length > 0) {
                    var html = '<table style="width: 100%; border-collapse: collapse;">';
                    html += '<tr style="background: #e0e0e0;"><th style="padding: 8px; text-align: left;">GPU</th><th style="padding: 8px; text-align: left;">Temperature</th><th style="padding: 8px; text-align: left;">Utilization</th><th style="padding: 8px; text-align: left;">Memory</th><th style="padding: 8px; text-align: left;">Status</th></tr>';

                    $.each(data.gpus, function(index, gpu) {
                        html += '<tr style="border-bottom: 1px solid #ddd;">';
                        html += '<td style="padding: 8px;">' + gpu.name + '</td>';
                        html += '<td style="padding: 8px;">' + gpu.temperature + '°C</td>';
                        html += '<td style="padding: 8px;">' + gpu.utilization + '%</td>';
                        html += '<td style="padding: 8px;">' + gpu.memory_used + ' / ' + gpu.memory_total + ' MB</td>';
                        html += '<td style="padding: 8px;">' + gpu.status + '</td>';
                        html += '</tr>';
                    });

                    html += '</table>';
                    $('#gpu-stats').html(html);
                } else {
                    $('#gpu-stats').html('<p><em>No GPUs detected or unable to retrieve statistics.</em></p>');
                }
            },
            error: function() {
                $('#gpu-stats').html('<p><em>Error loading GPU statistics. Please try again.</em></p>');
            }
        });
    }

    function loadGPUBinding() {
        $('#gpu-binding').html('<p><em>Loading GPU binding information...</em></p>');

        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/get_gpu_binding.php',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.gpus && data.gpus.length > 0) {
                    var html = '<table style="width: 100%; border-collapse: collapse;">';
                    html += '<tr style="background: #e0e0e0;"><th style="padding: 8px; text-align: left;">GPU</th><th style="padding: 8px; text-align: left;">Current Binding</th><th style="padding: 8px; text-align: left;">Driver</th><th style="padding: 8px; text-align: left;">Available</th></tr>';

                    // Populate GPU dropdown
                    $('#targetGPU').find('option').remove().end().append('<option value="">Select GPU...</option>');

                    $.each(data.gpus, function(index, gpu) {
                        html += '<tr style="border-bottom: 1px solid #ddd;">';
                        html += '<td style="padding: 8px;">' + gpu.name + '</td>';
                        html += '<td style="padding: 8px;">' + gpu.binding + '</td>';
                        html += '<td style="padding: 8px;">' + gpu.driver + '</td>';
                        html += '<td style="padding: 8px;">' + (gpu.available ? 'Yes' : 'No') + '</td>';
                        html += '</tr>';

                        // Add to dropdown
                        $('#targetGPU').append('<option value="' + gpu.id + '">' + gpu.name + '</option>');
                    });

                    html += '</table>';
                    $('#gpu-binding').html(html);
                } else {
                    $('#gpu-binding').html('<p><em>No GPUs detected or unable to retrieve binding information.</em></p>');
                }
            },
            error: function() {
                $('#gpu-binding').html('<p><em>Error loading GPU binding information. Please try again.</em></p>');
            }
        });
    }

    function applyGPUBinding() {
        var gpuId = $('#targetGPU').val();
        var bindingMode = $('#bindingMode').val();

        if (!gpuId) {
            alert('Please select a GPU first.');
            return;
        }

        $.ajax({
            url: '/plugins/gpu-switch-manager/scripts/apply_gpu_binding.php',
            method: 'POST',
            data: {
                gpu_id: gpuId,
                binding_mode: bindingMode
            },
            success: function() {
                alert('GPU binding applied successfully!');
                loadGPUBinding();
                loadGPUStats();
            },
            error: function() {
                alert('Error applying GPU binding. Please try again.');
            }
        });
    }
});
</script>

<h2><b>GPU Switch Manager Settings</b></h2>
<form name="gpu-switch-manager" method="POST">
    <input type="hidden" name="#file" value="gpu-switch-manager/gpu-switch-manager.cfg" />

    <h3><b>General Settings</b></h3>

